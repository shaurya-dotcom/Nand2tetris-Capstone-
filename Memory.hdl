// Hack memory map
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // RAM16K: 0x0000-0x3FFF
    Not(in=address[14], out=notA14);
    And(a=load, b=notA14, out=loadRAM);
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);

    // Screen: 0x4000-0x5FFF
    Not(in=address[13], out=notA13);
    And(a=address[14], b=notA13, out=screenSelect);
    And(a=load, b=screenSelect, out=loadScreen);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);

    // Keyboard is read-only at 0x6000.
    And(a=address[14], b=address[13], out=keySelect);
    Keyboard(out=keyboardOut);

    // Select output based on memory-mapped address.
    Mux16(a=ramOut, b=screenOut, sel=screenSelect, out=ramOrScreen);
    Mux16(a=ramOrScreen, b=keyboardOut, sel=keySelect, out=out);
}
